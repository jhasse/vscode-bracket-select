{
    "name": "bracket-select2",
    "displayName": "Bracket Select",
    "description": "Quick select code between brackets, support for (), {}, [], '' and \"\"",
    "version": "2.1.1",
    "publisher": "jhasse",
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.34.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/jhasse/vscode-bracket-select.git"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:bracket-select.select",
        "onCommand:bracket-select.select-include"
    ],
    "extensionKind":[
      "ui"
    ],
    "main": "./out/src/bracketSelectMain",
    "contributes": {
        "commands": [
            {
                "command": "bracket-select.select",
                "title": "BraSel:Select"
            },
            {
                "command": "bracket-select.select-include",
                "title": "BraSel:SelectInclude"
            }
        ],
        "keybindings": [
            {
                "command": "bracket-select.select",
                "key": "alt+a",
                "mac": "alt+a",
                "when": "editorTextFocus"
            },
            {
                "command": "bracket-select.select-include",
                "key": "ctrl+alt+a",
                "mac": "cmd+alt+a",
                "when": "editorTextFocus"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "test": "npm run compile && node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^12.12.0",
        "@types/vscode": "^1.34.0",
        "@vscode/test-electron": "^3.1.0",
        "mocha": "^12.0.3",
        "typescript": "^4.9.4"
    },
    "dependencies": {}
}
